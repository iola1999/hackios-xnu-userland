# A whitelist. In a workspace made by hackios-xnu-kernel's common/setup.sh this repository shares its
# working tree with the kernel repository; this file then lives in .userland.git/info/exclude
# (common/userland.exclude) instead, and only the files named here belong to it.
/*
!/.gitignore
!/README.md
!/LICENSE
!/userland/
!/ios165/
!/ios26/
!/prebuilt/
!/tools/
!/docs/

__pycache__/
.DS_Store
*~
*.orig
*.rej

/prebuilt/*
!/prebuilt/userland/
/docs/*
!/docs/air.md
!/docs/air-report.md
/tools/*
!/tools/apfs/
!/tools/air/
!/tools/mesa/
!/tools/metal/
!/tools/mk-mesa.sh
!/tools/mesa-stamp.sh
!/tools/mk-jb.sh
!/tools/jb-preinstall.py
!/tools/font_trim.py
!/tools/metallib.py

/userland/*
!/userland/build.sh
!/userland/*.py
!/userland/rc.*
!/userland/com.redwood.*.plist
!/userland/src/
!/userland/libmini/
!/userland/var/
!/userland/var.skel.extra

/ios165/*
!/ios165/fetch.sh
!/ios165/*.py
/ios26/*
!/ios26/fetch.sh
!/ios26/*.py
!/firmware-gen8/
/firmware-gen8/*
!/firmware-gen8/README.md
!/firmware-gen8/SHA256SUMS
!/firmware-gen8/LICENSE.qcom.txt
!/firmware-gen8/NOTICE.qcom.txt
!/firmware-gen8/gen80000-manifest.json
!/firmware-gen8/gen80000_*.fw
!/firmware-gen8/gen80000_gmu.bin
!/firmware-gen8/gen80000_zap.mbn
!/firmware-gen8/gen80200_*.fw
!/firmware-gen8/gen80200_gmu.bin
