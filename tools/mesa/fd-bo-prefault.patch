+/* The kernel maps a buffer on the first touch of each page, and on this device that fault costs
+ * milliseconds: 196 of them against 824 ms of wall clock in one draw's state emission, with 128 us of
+ * CPU, is the measurement this exists for. Touching one byte per page once, at the first map, moves
+ * that cost to a place where it is one line instead of a stall inside a draw. */
+static void
+fd_bo_prefault(struct fd_bo *bo)
+{
+   uint64_t began, took;
+   unsigned long page = (unsigned long)sysconf(_SC_PAGESIZE);
+   volatile uint8_t *bytes = bo->map;
+
+   if (bo->prefaulted || bo->map == NULL || bo->size == 0)
+      return;
+   bo->prefaulted = true;
+   if (page == 0)
+      page = 4096;
+
+   began = os_time_get_nano() / 1000;
+   for (unsigned off = 0; off < bo->size; off += page)
+      bytes[off] = bytes[off];   /* read then write the same byte: the write is what faults it in */
+   took = os_time_get_nano() / 1000 - began;
+
+   if (took >= 5000) {
+      printf("fd bo prefault slow: %p %u bytes %llu us\n", (void *)bo, bo->size,
+             (unsigned long long)took);
+      fflush(stdout);
+   }
+}
+
 /* For internal use only, does not check FD_BO_NOMAP: */
 void *
 __fd_bo_map(struct fd_bo *bo)
@@ -652,6 +682,7 @@
       }
    }
 
+   fd_bo_prefault(bo);
    return bo->map;
 }
 
