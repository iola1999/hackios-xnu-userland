+/* A call that returns before the batch dispatch has none of the three points below in it, and one
+ * the layer in front measured at half a second has to leave a trace somewhere: five such returns sit
+ * before the dispatch, and the time they spend in util_draw_indirect, in the condition check or in
+ * the user index upload is exactly what no window records. Same fields as the tail's line, with
+ * `call` and `tail` at 0 because neither happened. */
+static void
+fd_draw_early(const char *branch, uint64_t began)
+{
+   uint64_t total = fd_perf_us() - began;
+
+   if (total > 50000) {
+      printf("fd draw early: %s prologue %llu call 0 tail 0 total %llu us\n", branch,
+             (unsigned long long) total, (unsigned long long) total);
+      fflush(stdout);
    }
 }
 
