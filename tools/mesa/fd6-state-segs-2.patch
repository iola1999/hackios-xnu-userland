+
+/* The program-state segment holds most of every slow draw measured so far. These marks split it at
+ * the calls that stand on their own; the recorder is the caller's cursor, so an inner mark lands in
+ * the same list as the draw's own segments. */
+struct fd_draw_state_seg {
+   const char *name;
+   uint64_t us;
+};
+
+struct fd_draw_seg_recorder {
+   struct fd_draw_state_seg *segs;
+   unsigned *count;
+   uint64_t *cursor;
+};
+
+static void
+fd_seg_mark(struct fd_draw_seg_recorder *rec, const char *name)
+{
+   uint64_t now = fd_perf_us();
+
+   if (rec->count && *rec->count < 12) {
+      rec->segs[*rec->count].name = name;
+      rec->segs[*rec->count].us = now - *rec->cursor;
+      (*rec->count)++;
    }
+   *rec->cursor = now;
 }
 
