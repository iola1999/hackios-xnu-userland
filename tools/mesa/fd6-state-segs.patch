--- a/src/gallium/drivers/freedreno/a6xx/fd6_draw.cc
+++ b/src/gallium/drivers/freedreno/a6xx/fd6_draw.cc
@@ -393,6 +393,41 @@
     * cannot. */
    struct fd_draw_stamp entry = fd_draw_stamp_take();
    bool state_said = false;
+
+   /* A cursor over the state emission, advanced after every call that stands on its own. Which calls
+    * those are follows the code rather than a list written here, so a branch that changes the count
+    * changes the line and not the probe. Wall clock only: cpu and flt already ride on the state
+    * line, and eight of each would bury the number that matters. */
+   struct fd_draw_state_seg {
+      const char *name;
+      uint64_t us;
+   };
+   struct fd_draw_state_seg segs[8];
+   unsigned seg_count = 0;
+   uint64_t cursor = entry.wall;
+
+   auto mark = [&](const char *name) {
+      uint64_t now = fd_perf_us();
+
+      if (seg_count < 8) {
+         segs[seg_count].name = name;
+         segs[seg_count].us = now - cursor;
+         seg_count++;
+      }
+      cursor = now;
+   };
+
+   auto say_state = [&]() {
+      uint64_t total = cursor - entry.wall;
+
+      if (total > 50000) {
+         printf("fd draw state segs: total %llu us;", (unsigned long long) total);
+         for (unsigned i = 0; i < seg_count; i++)
+            printf(" %s %llu", segs[i].name, (unsigned long long) segs[i].us);
+         printf("\n");
+         fflush(stdout);
+      }
+   };
 
    if (++fd_draw_vbos_calls % 1000 == 0) {
       printf("fd draw vbos calls %llu\n", (unsigned long long) fd_draw_vbos_calls);
@@ -424,6 +459,7 @@
