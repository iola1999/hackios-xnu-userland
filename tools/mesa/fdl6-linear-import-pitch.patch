--- a/src/freedreno/fdl/freedreno_layout.h
+++ b/src/freedreno/fdl/freedreno_layout.h
@@ -73,6 +73,11 @@
 struct fdl_explicit_layout {
    uint32_t offset;
    uint32_t pitch;
+   /* HackiOS: when non-zero, a linear pitch under the layout's own alignment
+    * is accepted if it divides by this: a texel for an image that is only
+    * sampled, 64 bytes for a colour target (rendered in sysmem, see
+    * fd_gmem_render_tiles). */
+   uint32_t min_pitch_align;
 };
 
 /**
@@ -189,6 +194,10 @@
 static inline uint32_t
 fdl_pitch(const struct fdl_layout *layout, unsigned level)
 {
+   /* HackiOS: level 0 is pitch0 as laid out, which for an explicit layout can be
+    * finer than pitchalign (fd6_layout.c, min_pitch_align). */
+   if (level == 0)
+      return layout->pitch0;
    return align(u_minify(layout->pitch0, level), 1 << layout->pitchalign);
 }
 
