+
+/* The first draw of a new pipeline waits in ir3_get_shader() for this queue's initial-variant job,
+ * and with cpus=2 the queue has one thread. These lines split that wait: time queued behind other
+ * jobs, time the job ran, and how much of the run was the compile thread's own CPU. flt is the
+ * whole process's minor faults over the job (no per-thread count exists on XNU). Microseconds
+ * from os_time_get_nano. */
+static uint64_t
+ir3_probe_us(void)
+{
+   return os_time_get_nano() / 1000;
+}
+
+static uint64_t
+ir3_probe_tid(void)
+{
+   uint64_t tid = 0;
+
+   pthread_threadid_np(NULL, &tid);
+   return tid;
+}
+
+static uint64_t
+ir3_probe_cpu_us(void)
+{
+   mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+   struct thread_basic_info info;
+   mach_port_t self = pthread_mach_thread_np(pthread_self());
+
+   if (thread_info(self, THREAD_BASIC_INFO, (thread_info_t)&info, &count) != KERN_SUCCESS)
+      return 0;
+   return ((uint64_t)info.user_time.seconds + (uint64_t)info.system_time.seconds) * 1000000 +
+          (uint64_t)info.user_time.microseconds + (uint64_t)info.system_time.microseconds;
+}
+
+static long
+ir3_probe_flt(void)
+{
+   struct rusage usage;
+
+   return getrusage(RUSAGE_SELF, &usage) == 0 ? usage.ru_minflt : -1;
+}
 
+static void
+ir3_probe_queue(struct ir3_shader_state *hwcso, struct util_queue *queue)
+{
+   hwcso->queued_us = ir3_probe_us();
+   hwcso->queued_ahead = p_atomic_read(&queue->num_queued);   /* unlocked: a reading, not a decision */
+}
+
+static const char *
+ir3_probe_name(const struct ir3_shader *shader)
+{
+   return shader->nir && shader->nir->info.name ? shader->nir->info.name : "(none)";
+}
+
+static void
+ir3_probe_job(const struct ir3_shader_state *hwcso, uint64_t began, uint64_t cpu, long flt)
+{
+   const struct ir3_shader *shader = hwcso->shader;
+   uint64_t ended = ir3_probe_us();
+
+   printf("ir3q job: %s %s tid %llu ahead %d queued %llu run %llu cpu %llu flt %ld us\n",
+          _mesa_shader_stage_to_abbrev(shader->type), ir3_probe_name(shader),
+          (unsigned long long)ir3_probe_tid(), hwcso->queued_ahead,
+          (unsigned long long)(began - hwcso->queued_us), (unsigned long long)(ended - began),
+          (unsigned long long)(ir3_probe_cpu_us() - cpu), ir3_probe_flt() - flt);
+   fflush(stdout);
+}
