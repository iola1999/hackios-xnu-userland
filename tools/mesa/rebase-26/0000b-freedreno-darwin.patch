diff --git a/src/freedreno/drm/msm/msm_priv.h b/src/freedreno/drm/msm/msm_priv.h
index ea74225..9fc9e92 100644
--- a/src/freedreno/drm/msm/msm_priv.h
+++ b/src/freedreno/drm/msm/msm_priv.h
@@ -176,7 +176,16 @@ get_abs_timeout(struct drm_msm_timespec *tv, uint64_t ns)
    if (ns == OS_TIMEOUT_INFINITE)
       ns = 3600ULL * NSEC_PER_SEC; /* 1 hour timeout is almost infinite */
 
+#ifdef __APPLE__
+   /* The kernel's driver goes by the clock that runs on while the machine sleeps,
+    * mach_continuous_time(), which is this one. CLOCK_MONOTONIC is another on Darwin: the
+    * date less the date the system says it was started at. Where the two are not the
+    * same, a time made of the one is long past by the other, and nothing is waited for.
+    */
+   clock_gettime(CLOCK_MONOTONIC_RAW, &t);
+#else
    clock_gettime(CLOCK_MONOTONIC, &t);
+#endif
    tv->tv_sec = t.tv_sec + ns / NSEC_PER_SEC;
    tv->tv_nsec = t.tv_nsec + ns % NSEC_PER_SEC;
    if (tv->tv_nsec >= NSEC_PER_SEC) { /* handle nsec overflow */
