+/* The program-state segment holds most of every slow draw measured so far. These marks split it at
+ * the calls that stand on their own; the recorder is the caller's cursor, so an inner mark lands in
+ * the same list as the draw's own segments. */
+struct fd_draw_state_seg {
+   const char *name;
+   uint64_t us;
+};
+
+struct fd_draw_seg_recorder {
+   struct fd_draw_state_seg *segs;
+   unsigned *count;
+   uint64_t *cursor;
+};
+
+static void
+fd_seg_mark(struct fd_draw_seg_recorder *rec, const char *name)
+{
+   uint64_t now = fd_perf_us();
+
+   if (rec->count && *rec->count < 20) {
+      rec->segs[*rec->count].name = name;
+      rec->segs[*rec->count].us = now - *rec->cursor;
+      (*rec->count)++;
+   }
+   *rec->cursor = now;
+}
+
+/* ir3_cache_lookup, which the program-state segment spends its time in, takes no recorder: it is
+ * shared with other drivers. This hook and the pointer let it add marks to the active draw's cursor
+ * and cost one test on every other draw. */
+static struct fd_draw_seg_recorder *fd_active_rec;
+
+extern "C" void
+fd6_seg_mark_hook(const char *name)
+{
+   if (fd_active_rec)
+      fd_seg_mark(fd_active_rec, name);
+}
