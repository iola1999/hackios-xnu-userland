+          (unsigned long long) (w->track / w->frames), (unsigned long long) (w->prog / w->frames),
+          (unsigned long long) (w->emit / w->frames), (unsigned long long) (w->draw / w->frames),
+          (unsigned long long) (w->submit / w->frames), (unsigned long long) w->max_submit,
+          (unsigned long long) (w->client / w->frames), (unsigned long long) w->max_client,
