+/* How often the batch had to be cut because it was full, counted where the decision is made: a
+ * window of 256 draws that is cut every few draws pays the submission cost many times over, and
+ * that is invisible in the per-draw timing. */
+unsigned fd_perf_batch_cuts;
+
