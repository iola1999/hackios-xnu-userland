    rsc->valid = false;
 }
 
+/*
+ * HackiOS (libredwoodair, a Metal pass whose attachment is MTLLoadActionDontCare): the
+ * resource's contents stop mattering to the next batch that draws into it, so that batch does
+ * not read it back into GMEM. Unlike fd_invalidate_resource(), the batch that wrote it last
+ * keeps its resolve: a batch recorded since may still sample what it wrote. The framebuffer
+ * is marked dirty, so the next draw into the resource marks it valid again.
+ */
+void
+fd_resource_contents_undefined(struct pipe_context *pctx, struct pipe_resource *prsc) in_dt
+{
+   struct fd_resource *rsc = fd_resource(prsc);
+
+   if (prsc->target == PIPE_BUFFER)
+      return;
+   rsc->valid = false;
+   fd_dirty_resource(fd_context(pctx), prsc, FD_DIRTY_FRAMEBUFFER, true);
+}
+
 static enum pipe_format
 fd_resource_get_internal_format(struct pipe_resource *prsc)
 {
