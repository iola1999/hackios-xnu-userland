+#define ANNIBALE_IR3_CACHE_DIR "/private/var/db/annibale-ir3cache"
+
+static unsigned ir3_cache_hits;
+static unsigned ir3_cache_stores;
+
+static void
+ir3_cache_note(bool hit)
+{
+   unsigned h = hit ? p_atomic_inc_return(&ir3_cache_hits) : p_atomic_read(&ir3_cache_hits);
+   unsigned s = hit ? p_atomic_read(&ir3_cache_stores) : p_atomic_inc_return(&ir3_cache_stores);
+   unsigned total = h + s;
+
+   if (total == 1 || total == 8 || total == 32 || (total % 64) == 0) {
+      printf("ir3 cache[%s %d]: %u hits, %u stores\n",
+             util_get_process_name(), getpid(), h, s);
+      fflush(stdout);
+   }
+}
+
+static const uint8_t *
+get_darwin_macho_uuid(const void *addr, unsigned *uuid_len)
+{
+   Dl_info info;
+   if (!dladdr(addr, &info) || !info.dli_fbase)
+      return NULL;
+
+   const struct mach_header_64 *header = (const struct mach_header_64 *)info.dli_fbase;
+   if (header->magic != MH_MAGIC_64)
+      return NULL;
+
+   const uint8_t *cmd_ptr = (const uint8_t *)(header + 1);
+   for (uint32_t i = 0; i < header->ncmds; i++) {
+      const struct load_command *cmd = (const struct load_command *)cmd_ptr;
+      if (cmd->cmd == LC_UUID) {
+         const struct uuid_command *ucmd = (const struct uuid_command *)cmd;
+         *uuid_len = sizeof(ucmd->uuid);
+         return ucmd->uuid;
+      }
+      cmd_ptr += cmd->cmdsize;
+   }
+   return NULL;
+}
+#endif
