+static void fd_probe_flush_inside_emit(struct fd_batch *batch) assert_dt;
+
+/* HackiOS diagnostic probe (ring-history family, rebase-26 patch 0027):
+ * a flush entered while the emission section is open.  Upstream's own
+ * invariant is that the batch under construction survives emission --
+ * fd_draw_vbos asserts !batch->flushed right after the emit returns --
+ * so a flush of the batch being emitted can only come from reentrance:
+ * resource tracking, a blitter or a copy flushing on a hot path underneath
+ * the emission itself.  The line prints both the flushed batch and the
+ * context's current batch because they are not necessarily the same:
+ * write-write hazard handling legitimately flushes other batches, and
+ * only curbatch == batch is the form-B smoking gun.  Print-only, since
+ * the legitimate case exists; the frames line names the reentry path.
+ */
+static void
+fd_probe_flush_inside_emit(struct fd_batch *batch) assert_dt
+{
+   static unsigned prints;
+   uint64_t tid = 0;
+
+   if (prints >= FD_PROBE_PRINT_CAP)
+      return;
+   prints++;
+
+   pthread_threadid_np(NULL, &tid);
+   printf("fd flush inside emit: batch %p seqno %u curbatch %p curseqno %u "
+          "depth %u tid %llu\n",
+          (void *)batch, batch->seqno, (void *)batch->ctx->batch,
+          batch->ctx->batch ? batch->ctx->batch->seqno : 0,
+          batch->ctx->emit_depth, (unsigned long long)tid);
+   fflush(stdout);
+   slab_probe_frames();
+}
