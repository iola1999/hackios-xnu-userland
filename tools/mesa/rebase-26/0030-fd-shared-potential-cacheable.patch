 #define FD_BO_NOMAP               BITSET_BIT(2) /* Hint that the bo will not be mmap'd */
 
-/* Hint that the bo will be exported/shared: */
+/* Hint that the bo may be exported/shared, forcing a standalone allocation: */
 #define FD_BO_SHARED              BITSET_BIT(4)
 #define FD_BO_SCANOUT             BITSET_BIT(5)
 
 /* internal bo flags: */
 #define _FD_BO_NOSYNC             BITSET_BIT(7) /* Avoid userspace fencing on control buffers */
+
+/* The bo really has been imported or exported, so userspace fences no longer
+ * describe every consumer. FD_BO_SHARED only says that this may still happen;
+ * by itself it must not disable cache reuse or fence tracking.
+ */
+#define _FD_BO_EXPORTED           BITSET_BIT(12)
 
 /* Additional flags hinting usage, only used for tracing.  Buffers without
  * one of these flags set will be presumed to be driver internal.
