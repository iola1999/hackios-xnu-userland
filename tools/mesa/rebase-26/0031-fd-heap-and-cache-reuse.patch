+static pthread_mutex_t fd_bo_stats_mtx = PTHREAD_MUTEX_INITIALIZER;
+
+void
+fd_bo_stats_note(enum fd_bo_stat_kind kind, uint32_t value)
+{
+   switch (kind) {
+   case FD_BO_STAT_DEFAULT_HEAP:
+      p_atomic_add(&fd_bo_stats.def_heap, value);
+      break;
+   case FD_BO_STAT_RING_HEAP:
+      p_atomic_add(&fd_bo_stats.ring_heap, value);
+      break;
+   case FD_BO_STAT_BO_CACHE_HIT:
+      p_atomic_add(&fd_bo_stats.bo_hit, value);
+      break;
+   case FD_BO_STAT_BO_CACHE_MISS:
+      p_atomic_add(&fd_bo_stats.bo_miss, value);
+      break;
+   case FD_BO_STAT_RING_CACHE_HIT:
+      p_atomic_add(&fd_bo_stats.ring_hit, value);
+      break;
+   case FD_BO_STAT_RING_CACHE_MISS:
+      p_atomic_add(&fd_bo_stats.ring_miss, value);
+      break;
+   case FD_BO_STAT_EXPIRED:
+      p_atomic_add(&fd_bo_stats.expired, value);
+      break;
+   case FD_BO_STAT_EVICTED:
+      p_atomic_add(&fd_bo_stats.evicted, value);
+      break;
+   case FD_BO_STAT_MADE:
+      p_atomic_inc(&fd_bo_stats.made);
+      if (value == (FD_BO_NOMAP | FD_BO_HINT_IMAGE))
+         p_atomic_inc(&fd_bo_stats.fl_204);
+      else if (value == (FD_BO_SHARED | FD_BO_HINT_BUFFER))
+         p_atomic_inc(&fd_bo_stats.fl_110);
+      else if (value == FD_BO_NOMAP)
+         p_atomic_inc(&fd_bo_stats.fl_4);
+      else if (value == (FD_BO_GPUREADONLY | FD_BO_HINT_COMMAND))
+         p_atomic_inc(&fd_bo_stats.fl_402);
+      else
+         p_atomic_inc(&fd_bo_stats.fl_other);
+      break;
+   }
+
+   uint64_t now = os_time_get_nano();
+   uint64_t since = READ_ONCE(fd_bo_stats.since_ns);
+   if (since == 0) {
+      if (pthread_mutex_trylock(&fd_bo_stats_mtx) == 0) {
+         if (fd_bo_stats.since_ns == 0)
+            fd_bo_stats.since_ns = now;
+         pthread_mutex_unlock(&fd_bo_stats_mtx);
+      }
+      return;
+   }
+   if (now - since < 5000000000ull)
+      return;
+   if (pthread_mutex_trylock(&fd_bo_stats_mtx) != 0)
+      return;
+   since = fd_bo_stats.since_ns;
+   if (now - since >= 5000000000ull) {
+      uint32_t def_heap = p_atomic_xchg(&fd_bo_stats.def_heap, 0);
+      uint32_t ring_heap = p_atomic_xchg(&fd_bo_stats.ring_heap, 0);
+      uint32_t bo_hit = p_atomic_xchg(&fd_bo_stats.bo_hit, 0);
+      uint32_t bo_miss = p_atomic_xchg(&fd_bo_stats.bo_miss, 0);
+      uint32_t ring_hit = p_atomic_xchg(&fd_bo_stats.ring_hit, 0);
+      uint32_t ring_miss = p_atomic_xchg(&fd_bo_stats.ring_miss, 0);
+      uint32_t expired = p_atomic_xchg(&fd_bo_stats.expired, 0);
+      uint32_t evicted = p_atomic_xchg(&fd_bo_stats.evicted, 0);
+      uint32_t made = p_atomic_xchg(&fd_bo_stats.made, 0);
+      uint32_t fl_204 = p_atomic_xchg(&fd_bo_stats.fl_204, 0);
+      uint32_t fl_110 = p_atomic_xchg(&fd_bo_stats.fl_110, 0);
+      uint32_t fl_4 = p_atomic_xchg(&fd_bo_stats.fl_4, 0);
+      uint32_t fl_402 = p_atomic_xchg(&fd_bo_stats.fl_402, 0);
+      uint32_t fl_other = p_atomic_xchg(&fd_bo_stats.fl_other, 0);
+      fd_bo_stats.since_ns = now;
+      if (def_heap || ring_heap || bo_hit || bo_miss || ring_hit || ring_miss ||
+          expired || evicted || made) {
+         printf("fd bo stats[%d]: %llu ms def_heap=%u ring_heap=%u bo_hit=%u bo_miss=%u "
+                "ring_hit=%u ring_miss=%u made=%u (0x204=%u 0x110=%u 0x4=%u 0x402=%u other=%u) "
+                "exp=%u evict=%u\n",
+                (int)getpid(), (unsigned long long)((now - since) / 1000000ull),
+                def_heap, ring_heap, bo_hit, bo_miss, ring_hit, ring_miss,
+                made, fl_204, fl_110, fl_4, fl_402, fl_other, expired, evicted);
+         fflush(stdout);
+      }
+   }
+   pthread_mutex_unlock(&fd_bo_stats_mtx);
+}
+#endif
