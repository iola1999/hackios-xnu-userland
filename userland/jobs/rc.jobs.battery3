# Commands run by the launchd job com.annibale.demo (see com.annibale.demo.plist).
# An hour of use before Settings > Battery is opened (with adsp=1): applications opened in turn -- Settings, Notes,
# Calendar -- so that the power log has an hour of their use to show; then the battery page, scrolled, and Battery
# Health & Charging, for screenshots; at the end what the power log has collected (battery_test powerlog).
/annibale/bin/sound_test springboard
/annibale/bin/anntouch wait 20
/annibale/bin/battery_test open prefs:root=General
/annibale/bin/anntouch wait 600
/annibale/bin/battery_test open mobilenotes://
/annibale/bin/anntouch wait 600
/annibale/bin/battery_test open calshow://
/annibale/bin/anntouch wait 600
/annibale/bin/battery_test open prefs:root=DISPLAY
/annibale/bin/anntouch wait 600
/annibale/bin/battery_test open mobilenotes://
/annibale/bin/anntouch wait 600
/annibale/bin/battery_test open calshow://
/annibale/bin/anntouch wait 600
/annibale/bin/battery_test open prefs:root=BATTERY_USAGE
/annibale/bin/anntouch wait 15 drag 0.5 0.85 0.5 0.35 1500 400 wait 4 drag 0.5 0.85 0.5 0.35 1500 400 wait 6
/annibale/bin/battery_test open prefs:root=BATTERY_USAGE&path=BATTERY_HEALTH
/annibale/bin/anntouch wait 10
/annibale/bin/battery_test powerlog
