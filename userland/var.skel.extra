# Lines added to the data volume template on top of the image's own (etc/var.skel), read by build.sh
# when it writes the skeleton and by tools/k90auto/package.py when it checks the packaged copy. One
# file, two readers: installd needs MobileInstallation before it can write install records, and
# SpringBoard reads its layout from SpringBoard. The last two give iconservicesagent (user
# _iconservices, uid 276, home /var/empty) the folder Metal's shader cache looks for under its home.
# /private/var/empty itself is in the image's template: init stops at the first line whose directory
# already exists, so no line here may repeat one of those.
d	755	501	501	/private/var/mobile/Library/MobileInstallation
d	755	501	501	/private/var/mobile/Library/SpringBoard
d	755	0	0	/private/var/empty/Library
d	755	276	276	/private/var/empty/Library/Caches
d	755	501	501	/private/var/mobile/Containers/Data/Application
d	755	501	501	/private/var/mobile/Containers/Shared/AppGroup
d	755	501	501	/private/var/mobile/Library/SafariSafeBrowsing
